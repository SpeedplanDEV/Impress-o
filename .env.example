# Copie para .env (ou defina as variáveis no ambiente) — todas são opcionais.

# Porta e endereço do servidor local
PORT=3070
HOST=127.0.0.1

# Banco de dados na nuvem (gratuito): cole aqui a "connection string" do Supabase ou do Neon.
# Vazio = SQLite local em ./data/impress-o.sqlite (não precisa de nada instalado).
#
# Supabase (Project Settings → Database → Connection string → URI, modo "Session pooler"):
#   DATABASE_URL=postgresql://postgres.xxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Neon (Dashboard → Connection details):
#   DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# SSL do banco na nuvem: ligado por padrão sem validar a cadeia de certificados.
# Use "verify" para exigir certificado válido (Neon aceita; no Supabase pode exigir o CA do projeto).
# IMPRESSO_DB_SSL=verify

# Pasta local para saída de impressão e (no modo SQLite) o banco e os arquivos
# IMPRESSO_DATA_DIR=./data

# Hosts extras aceitos pela API (se acessar por outro nome/IP além de localhost), separados por vírgula
# IMPRESSO_ALLOWED_HOSTS=meu-pc.local,192.168.0.10

# Marque 1 quando o sistema estiver atrás de HTTPS (cookie de sessão Secure)
# IMPRESSO_SECURE_COOKIES=0
